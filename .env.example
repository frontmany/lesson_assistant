# Источник звука урока, call это звонок, virtual это записанный урок
SOURCE_MODE=call
DEMO_LESSON_DIR=data/demo_lesson  # путь от папки backend
# Длина урока в минутах
LESSON_MINUTES=40

# LiveKit, ключи devkey и secret только для разработки
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# Адрес машины в локальной сети, по нему идёт звук звонка
LIVEKIT_NODE_IP=192.168.1.10
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Токен бота MAX
MAX_BOT_TOKEN=
MAX_API_URL=https://platform-api2.max.ru
# Имя бота для ссылок приглашений, пусто значит взять из токена
MAX_BOT_NAME=
# Подпись сессий приложения, пусто значит взять из токена бота
SESSION_SECRET=
# 1 только для разработки, на сервере 0
DEV_AUTH=1

# Модели распознавания речи для учителя и учеников
WHISPER_MODEL_TEACHER=gigaam-v3-e2e-ctc
WHISPER_MODEL_STUDENT=gigaam-v3-e2e-ctc
WHISPER_COMPUTE_TYPE=int8
# Папка для сохранения фраз, только для тестовых уроков
SAVE_PHRASES_DIR=

# Ключ GigaChat для сводки и карточек, без него они строятся по шаблону
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# По умолчанию SQLite, в compose PostgreSQL
DATABASE_URL=sqlite:///./lesson_assistant.sqlite3
