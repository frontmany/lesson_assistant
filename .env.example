# Откуда берётся звук урока:
#   call    — настоящий звонок в LiveKit (основной режим)
#   virtual — записанный урок из DEMO_LESSON_DIR, его участники заходят в звонок ботами
SOURCE_MODE=call
DEMO_LESSON_DIR=data/demo_lesson

# Публичный HTTPS-адрес сервера: нужен для мини-приложения и webhook бота
PUBLIC_URL=https://example.com

# LiveKit. В docker compose сервер ходит в LiveKit по имени сервиса,
# а браузер — по публичному адресу. devkey/secret — ключи режима --dev,
# на боевом сервере заменить
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Бот MAX: токен выдаёт бот «Идея фикс»
MAX_BOT_TOKEN=
MAX_API_URL=https://platform-api2.max.ru
# polling для разработки, webhook для боевого режима
MAX_BOT_MODE=polling

# Распознавание речи
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8

# LLM для сводки. Без ключа сводка строится по шаблону
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# Хранилище: по умолчанию SQLite, для compose — PostgreSQL и Redis
DATABASE_URL=sqlite:///./lesson_assistant.sqlite3
REDIS_URL=
