# Откуда берётся звук урока:
#   call    — настоящий звонок в LiveKit (основной режим)
#   virtual — записанный урок из DEMO_LESSON_DIR, его участники заходят в звонок ботами
SOURCE_MODE=call
DEMO_LESSON_DIR=data/demo_lesson
# Длина урока в минутах: по ней шкала смягчает норму и ставит флаг «давно не отвечал»
LESSON_MINUTES=40

# Публичный HTTPS-адрес сервера: нужен для мини-приложения и webhook бота
PUBLIC_URL=https://example.com

# LiveKit. В docker compose сервер ходит в LiveKit по имени сервиса,
# а браузер — по публичному адресу. devkey/secret — ключи режима --dev,
# на боевом сервере заменить
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# IPv4 этой машины в локальной сети (ipconfig / ip addr): его LiveKit отдаёт браузерам для звука
LIVEKIT_NODE_IP=192.168.1.10
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Бот MAX: токен выдаёт бот «Идея фикс»
MAX_BOT_TOKEN=
MAX_API_URL=https://platform-api2.max.ru
# polling для разработки, webhook для боевого режима
MAX_BOT_MODE=polling
# имя бота: кнопка «Начать урок» открывает мини-приложение, привязанное к нему
MAX_BOT_NAME=ideya_fiks_161_bot
# подпись сессий мини-приложения: длинная случайная строка. Пусто — берётся от токена бота
SESSION_SECRET=
# 1 — для разработки: участника можно назвать в адресе (student.html?id=ivan_i). На сервере 0
DEV_AUTH=1

# Распознавание речи
# Учителю и ученикам — GigaAM v3: по замерам точнее и быстрее Whisper (analytics/README.md).
# Модели можно задать раздельно. Whisper: small, medium, large-v3-turbo; GigaAM v3: gigaam-v3-e2e-ctc
WHISPER_MODEL_TEACHER=gigaam-v3-e2e-ctc
WHISPER_MODEL_STUDENT=gigaam-v3-e2e-ctc
WHISPER_COMPUTE_TYPE=int8
# Сохранять каждую найденную фразу (wav и текст), например /srv/saved_phrases.
# Только для тестовых уроков команды: голоса детей не сохраняем
SAVE_PHRASES_DIR=

# GigaChat для сводки и карточек (#21). Без ключа они строятся по шаблону.
# Ключ — Authorization Key проекта GigaChat API в личном пространстве
# developers.sber.ru (бесплатный тариф для физлиц). Адрес и модель можно не
# задавать: по умолчанию https://api.giga.chat/v1 и GigaChat-3-Ultra
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# Хранилище: по умолчанию SQLite, для compose — PostgreSQL и Redis
DATABASE_URL=sqlite:///./lesson_assistant.sqlite3
REDIS_URL=
